# === IBM Cloud / watsonx.ai ===
# Get these from your IBM Cloud account → watsonx.ai service
LLM_API_KEY=<your-ibm-cloud-api-key>
WATSONX_PROJECT_ID=<your-watsonx-project-id>
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# === LLM Configuration ===
LLM_PROVIDER=watsonx
LLM_MODEL=ibm/granite-3-3-8b-instruct

# === Signing ===
SIGNING_METHOD=ed25519
ED25519_PRIVATE_KEY_PATH=data/ed25519.key

# === Admin Auth ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=<generate-a-random-token>

# === GitHub App ===
GITHUB_APP_ID=<your-github-app-id>
GITHUB_APP_PRIVATE_KEY_PATH=<path-to-pem-file>
GITHUB_WEBHOOK_SECRET=<your-webhook-secret>

# === Database ===
DATABASE_PATH=data/audit.db
CAPSULE_EXPIRY_HOURS=1

# === Governed MCP Runtime ===
# Root the governed MCP tool handler may read/write within (defense-in-depth
# on top of per-capsule target_paths).
WORKSPACE_ROOT=.

# === Server ===
HOST=0.0.0.0
PORT=8000
